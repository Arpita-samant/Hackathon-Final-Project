# ==============================================================================
# Yojana Sahayak Environment Variables
# ==============================================================================

# Backend & API Base URL (Connected to Vercel Backend)
BACKEND_URL=https://hackathon-final-project-beige.vercel.app
NEXT_PUBLIC_BASE_URL=https://hackathon-final-project-beige.vercel.app
VITE_BASE_URL=https://hackathon-final-project-beige.vercel.app

# ==============================================================================
# GMAIL SMTP OTP DELIVERY CONFIGURATION
# ==============================================================================
# To send real verification codes directly to user Gmail inboxes:
# 1. Go to your Google Account (myaccount.google.com) -> Security
# 2. Enable "2-Step Verification" if not already enabled
# 3. Search for "App Passwords" (under 2-Step Verification)
# 4. Create a new App Password named "Yojana Sahayak" and paste the 16-character code below:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ==============================================================================
# AI & RAG INTELLIGENCE (Optional)
# ==============================================================================
# Provide GEMINI_API_KEY or OPENAI_API_KEY for live AI synthesis.
# If omitted, Yojana Sahayak uses its built-in deterministic RAG extractive generator with 100% cited accuracy.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Ports
PORT=8000
FRONTEND_PORT=3000
