# Backend Base URL
BACKEND_URL=https://hackathon-final-project-beige.vercel.app
NEXT_PUBLIC_BASE_URL=https://hackathon-final-project-beige.vercel.app
VITE_BASE_URL=https://hackathon-final-project-beige.vercel.app

# ==============================================================================
# Google Firebase Phone Authentication (SMS OTP)
# Get these credentials from: https://console.firebase.google.com/
# 1. Create a Firebase project
# 2. Add a Web App
# 3. Enable Authentication -> Sign-in method -> Phone
# 4. Copy config values below (also set in Vercel Project -> Settings -> Environment Variables)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
